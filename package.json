{
	"name": "@ghostpaw/codex",
	"version": "0.3.2",
	"description": "Standalone belief and memory engine for Node.js — SQLite, zero dependencies, with a built-in LLM tool facade",
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./mcp": {
			"import": {
				"types": "./dist/mcp.d.ts",
				"default": "./dist/mcp.js"
			},
			"require": {
				"types": "./dist/mcp.d.cts",
				"default": "./dist/mcp.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"skills",
		"SKILL.md"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"demo:build": "node scripts/build_demo.mjs",
		"demo:watch": "node scripts/build_demo.mjs --watch",
		"demo:serve": "npm run demo:build && node scripts/serve_demo.mjs",
		"test": "node --experimental-strip-types --test --test-reporter=dot 'src/**/*.test.ts'",
		"lint": "biome check",
		"lint:fix": "biome check --fix",
		"format": "biome format --write",
		"typecheck": "tsc --noEmit",
		"check": "npm run check:types && npm run check:lint && npm test && npm run build && npm run check:deps && npm run check:surfaces && npm run check:size && npm run check:api && npm run check:consumer && npm run check:startup && npm run check:ratchet",
		"clean": "rm -rf dist demo",
		"version": "node scripts/sync_version.mjs && npm run surfaces && git add src/version.ts SKILL.md skills plugin.json mcp.json server.json .claude-plugin mcpb && biome format --write package.json package-lock.json && git add package.json package-lock.json",
		"prepublishOnly": "npm run check",
		"release:patch": "npm version patch && git push && git push --tags",
		"release:minor": "npm version minor && git push && git push --tags",
		"release:major": "npm version major && git push && git push --tags",
		"surfaces": "node --experimental-strip-types scripts/surfaces/generate.mjs",
		"check:surfaces": "node --experimental-strip-types scripts/surfaces/generate.mjs --check",
		"check:types": "tsc --noEmit",
		"check:lint": "biome check",
		"check:ratchet": "node --test scripts/guard/*.test.mjs && node scripts/guard/ratchet.mjs",
		"budgets:update": "npm run build && node scripts/guard/size.mjs --update && node scripts/guard/api.mjs --update && node scripts/guard/startup.mjs --update",
		"bench": "npm run build && node scripts/bench/bench.mjs",
		"check:deps": "node scripts/check-zero-deps.mjs",
		"check:size": "node scripts/guard/size.mjs",
		"check:api": "node scripts/guard/api.mjs",
		"check:consumer": "node scripts/guard/consumer.mjs",
		"check:startup": "node scripts/guard/startup.mjs",
		"mcpb": "node scripts/mcpb/build.mjs"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"belief",
		"memory",
		"knowledge",
		"certainty",
		"provenance",
		"recall",
		"semantic-search",
		"embeddings",
		"sqlite",
		"local-first",
		"llm",
		"ai",
		"agent",
		"tools",
		"typescript",
		"zero-dependencies",
		"mcp",
		"mcp-server",
		"model-context-protocol",
		"agent-memory",
		"agent-skills",
		"claude-code",
		"cursor",
		"cli"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/GhostPawJS/codex.git"
	},
	"author": {
		"name": "Anonyfox",
		"email": "max@anonyfox.com",
		"url": "https://anonyfox.com"
	},
	"homepage": "https://codex.ghostpaw.dev/",
	"bugs": {
		"url": "https://github.com/GhostPawJS/codex/issues"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/Anonyfox"
	},
	"volta": {
		"node": "24.14.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"@types/node": "^25.3.0",
		"esbuild": "^0.27.4",
		"preact": "^10.29.0",
		"sql.js-fts5": "^1.4.0",
		"tsup": "^8.4.0",
		"typescript": "^5.9.3",
		"fflate": "0.8.3"
	},
	"bin": {
		"ghostpaw-codex": "./dist/cli.js"
	},
	"mcpName": "io.github.GhostPawJS/codex"
}

{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.GhostPawJS/codex",
  "description": "Local belief and memory engine with evidence, certainty, and honest revision history.",
  "title": "GhostPaw Codex",
  "version": "0.3.1",
  "repository": {
    "url": "https://github.com/GhostPawJS/codex.git",
    "source": "github"
  },
  "websiteUrl": "https://ghostpaw.anonyfox.com/codex/",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@ghostpaw/codex",
      "version": "0.3.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "GHOSTPAW_CODEX_DB",
          "description": "SQLite database path (default: ~/.ghostpaw/codex.db)",
          "isRequired": false
        }
      ]
    }
  ]
}
